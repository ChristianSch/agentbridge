[Unit]
Description=AgentBridge
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=user
EnvironmentFile=-/etc/agentbridge/agentbridge.env
ExecStart=/usr/local/bin/agentbridge --config /home/user/.config/agentbridge/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
