bind: "127.0.0.1:7777"
token: "change-me"

pi:
  binary: "pi"
  idle_timeout: "30m"

hermes:
  venv: "" # auto-detects venv/.venv in the Hermes repo when present
  gateway_module: "tui_gateway.entry"
  cwd: "" # auto-detects ~/.hermes/hermes-agent when present
  idle_timeout: "30m"

terminal:
  shell: "/bin/bash"
  idle_timeout: "60m"
  max_sessions: 10

attachments:
  enabled: true
  max_size: "25MB"
  allowed_mime_types:
    - "image/png"
    - "image/jpeg"
    - "image/webp"
    - "image/gif"
    - "text/plain"
    - "text/markdown"
    - "application/pdf"
    - "audio/webm"
    - "audio/wav"
    - "audio/mpeg"
    - "audio/mp4"
  retention: "168h"

voice:
  enabled: true
  backend: "whispercpp"
  binary: "whisper-cli"
  model: "" # e.g. /home/user/models/ggml-base.en.bin
  language: "auto"
  threads: 4
  timeout: "2m"

auth:
  passkeys: false
  allow_insecure_no_auth: false # only set true for loopback-only throwaway development
  rp_id: "sam-1.example.ts.net" # host only, no scheme
  origins:
    - "https://sam-1.example.ts.net"

notifications:
  backend: "" # "ntfy" to enable
  ntfy_topic: "agentbridge"
  ntfy_server: "https://ntfy.sh"
  notify_on:
    - "waiting_for_input"
    - "approval_request"

activity_summary:
  enabled: true
  provider: "" # "openai" or "anthropic"; inferred from model/endpoint when empty
  endpoint: "" # optional; defaults to provider API when model is set
  api_key: "" # or AGENTBRIDGE_ACTIVITY_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
  model: "" # e.g. gpt-4o-mini or claude-3-5-haiku-latest; empty uses deterministic summaries
  debounce: "900ms"

projects:
  - name: "webapp"
    path: "/home/user/projects/webapp"
    agent: "pi"
