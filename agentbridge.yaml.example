bind: "127.0.0.1:7777"
token: "change-me"

pi:
  binary: "pi"
  idle_timeout: "30m"

hermes:
  venv: "" # auto-detects venv/.venv in the Hermes repo when present
  gateway_module: "tui_gateway.entry"
  cwd: "" # auto-detects ~/.hermes/hermes-agent when present
  idle_timeout: "30m"

terminal:
  shell: "/bin/bash"
  idle_timeout: "60m"
  max_sessions: 10

auth:
  passkeys: false
  rp_id: "sam-1.example.ts.net" # host only, no scheme
  origins:
    - "https://sam-1.example.ts.net"

notifications:
  backend: "" # "ntfy" to enable
  ntfy_topic: "agentbridge"
  ntfy_server: "https://ntfy.sh"
  notify_on:
    - "waiting_for_input"
    - "approval_request"

activity_summary:
  enabled: true
  provider: "" # "openai" or "anthropic"; inferred from model/endpoint when empty
  endpoint: "" # optional; defaults to provider API when model is set
  api_key: "" # or AGENTBRIDGE_ACTIVITY_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
  model: "" # e.g. gpt-4o-mini or claude-3-5-haiku-latest; empty uses deterministic summaries
  debounce: "900ms"

projects:
  - name: "webapp"
    path: "/home/user/projects/webapp"
    agent: "pi"
